@model Project_Management.Models.Deal

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Project_Management.Models.project_managementEntities db = new Project_Management.Models.project_managementEntities();
    Project_Management.Controllers.PackagesController tech = new Project_Management.Controllers.PackagesController();

    int sn = 0;
}




<main>
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="card-title mb-0">
                        @Model.name
                    </h4>

                    <div class="dropdown d-inline-block">
                        <button type="button" class="btn header-item waves-effect text-dark"
                                id="page-header-user-dropdown"
                                data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fa fa-ellipsis-v"></i>
                            <i class="mdi mdi-chevron-down d-none d-xl-inline-block"></i>
                        </button>

                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item" href="@Url.Action("Index","Deals")">
                                <i class="bx bx-edit font-size-16 align-middle me-1"></i> Index
                            </a>
                            <a class="dropdown-item" href="#edit_@Model.id" data-toggle="modal">
                                <i class="bx bx-edit font-size-16 align-middle me-1"></i> Edit
                            </a>
                            <a class="dropdown-item" href="#delete_@Model.id" data-toggle="modal">
                                <i class="bx bx-trash font-size-16 align-middle me-1"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>

                <!---------------------- EDIT DEAL------------------------>
                <div id="edit_@Model.id" class="modal fade" role="dialog">
                    <div class="modal-dialog modal-xl">
                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title">
                                    Edit Deal Info
                                </h4>
                            </div>
                            <div class="modal-body">

                                <form class="custom-validation" action="@Url.Action("Edit","Deals")" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.id" />
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="form-label">Name</label>
                                                <input type="text" name="name" class="form-control" value="@Model.name" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Pipeline</label>
                                                <input type="text" name="pipeline" class="form-control" value="@Model.pipeline" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Deal Stages</label>
                                                <select name="dealcategory" class="form-control">
                                                    <option value="@Model.dealstages">@Model.dealstages</option>
                                                    <option>Generated</option>
                                                    <option>Qualified</option>
                                                    <option>Initial Contact</option>
                                                    <option>Schedule Appointment</option>
                                                    <option>Proposal Sent</option>
                                                    <option>Win</option>
                                                    <option>Lost</option>
                                                </select>
                                            </div>
                                        </div>

                                        <br />

                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="form-label">Deal Category</label>
                                                <select name="dealcategory" class="form-control" required>
                                                    <option value="@Model.dealcategory">@Model.dealcategory</option>
                                                    <option>Best Case</option>
                                                    <option>Closed</option>
                                                    <option>Commit</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label>Deal Agent</label>
                                                <select class="form-control" name="dealagent" required="">
                                                    <option value="@Model.dealagent">@Model.dealagent</option>
                                                    @foreach (var Modal in db.Employees.ToList())
                                                    {
                                                        <option value="@Model.id">@Model.name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Deal Value</label>
                                                <input type="text" name="dealvalue" class="form-control" value="@Model.dealvalue" />
                                            </div>
                                        </div>

                                        <br />

                                        <div class="row">
                                            <div class="col-md-4">
                                                <label>Close Date</label>
                                                <input type="date" name="closedate" class="form-control" value="@Model.closedate" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Product</label>
                                                <input type="text" name="product" class="form-control" value="@Model.product" />
                                            </div>
                                            <div class="col-md-4">
                                                <label>Deal Watcher</label>
                                                <select class="form-control" name="dealagent" required="">
                                                    <option value="@Model.dealwatcher">@Model.dealwatcher</option>
                                                    @foreach (var Modal in db.Employees.ToList())
                                                    {
                                                        <option value="@Model.id">@Model.name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <br />
                                    <div class="row">
                                        <div class="col-md-12 text-center">
                                            <button type="submit" class="btn btn-block btn-success">Submit</button>
                                            <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>


                <!---------------------- Delete Modal --------------------- -->
                <div id="delete_@Model.id" class="modal fade" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content shadow-lg border-0 rounded-4">

                            <!-- Header -->
                            <div class="modal-header bg-danger text-white justify-content-center">
                                <h5 class="modal-title fw-bold">
                                    <i class="mdi mdi-alert-circle-outline me-2"></i>Are you sure?
                                </h5>
                            </div>

                            <!-- Body -->
                            <div class="modal-body text-center p-4">
                                <div class="mb-3">
                                    <i class="mdi mdi-delete-circle text-danger" style="font-size: 4rem;"></i>
                                </div>
                                <p class="text-muted mb-0">
                                    You will <strong>not</strong> be able to recover the deleted record!
                                </p>
                                <h6 class="mt-2 text-danger">@Model.name</h6>
                            </div>

                            <!-- Footer -->
                            <div class="modal-footer border-0">
                                @using (Html.BeginForm("Delete", "Deals", FormMethod.Post, new { @class = "w-100" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.id" />
                                    <div class="d-flex justify-content-center gap-2">
                                        <button type="submit" class="btn btn-danger btn-lg px-4">
                                            <i class="mdi mdi-check-circle me-1"></i>Yes, Delete It!
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-lg px-4" data-bs-dismiss="modal">
                                            <i class="mdi mdi-close-circle me-1"></i>Cancel
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>


                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                Deal Info
                            </div>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    🧑 Deal Name <span>@Model.name</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    🧑 Lead Contact <span>@Model.Lead_Contact.name</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    📧 Email <span>@Model.Lead_Contact.email</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    🏢 Company Name <span>@Model.Lead_Contact.company001.name</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    🌐 Deal Category <span>@Model.dealcategory</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    📱 Deal agent <span>@Model.dealagent</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    ☎️ Deal Watcher <span>@Model.dealwatcher</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    🌍 Deal Value <span>@Model.dealvalue</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    🗺️ Products <span>@Model.product</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    🏙️ City <span>@Model.closedate</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                Lead Contact Detail
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        🧑 Lead Contact  <span>@Model.Lead_Contact.name</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        💾 Email  <span>@Model.Lead_Contact.email</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        👥 Company Name <span>@Model.Lead_Contact.company001.name</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        🧾 Mobile <span>@Model.Lead_Contact.company001.mobile</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</main>


<div class="col-xl-12">
    <div class="card">
        <div class="card-body">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs nav-tabs-custom nav-justified" role="tablist">

                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#file" role="tab">
