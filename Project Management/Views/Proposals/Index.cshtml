@*@model IEnumerable<Project_Management.Models.Proposals>*@
@{
    ViewBag.Title = "Deals";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Project_Management.Models.project_managementEntities db =
        new Project_Management.Models.project_managementEntities();
    int sn = 0;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <h4 class="card-title mb-2">Proposal</h4>
                        <div class="alert alert-info alert-dismissible fade show mb-0" role="alert">
                            <i class="mdi mdi-alert-circle-outline me-2"></i>
                            Proposal are for Leads. If you want to create for existing clients, then create Estimate!
                            <button type="button" class="btn-close" data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>
                        </div>
                        <br /> 
                        <a href="@Url.Action("create","Proposals")"
                           class="btn btn-primary fw-medium font-size-16">
                            <i class="mdi mdi-plus-circle-outline"></i>
                            <span>Create Proposal</span>
                        </a>
                        <a href="@Url.Action("template","Proposals")"
                           class="btn btn-secondary fw-medium font-size-16">
                            <i class="mdi mdi-folder-home"></i>
                            <span>Proposal Template</span>
                        </a>                      
                    </div>

                    <!-- toggle icon pushed to the far right -->
                    @*<a href="javascript:void(0);" id="toggleView" class="btn btn-sm btn-outline-secondary align-self-start"
                       title="Switch view" style="font-size:18px;">
                        <i class="fa fa-th-large"></i>
                    </a>*@
                </div>

                <!-- TABLE VIEW (default) -->
                <div id="ifTable">
                    <div class="table-rep-plugin">
                        <div class="table-responsive mb-0" data-pattern="priority-columns">
                            <table id="datatable-buttons"
                                   class="table table-striped table-bordered">
                                <thead class="thead-light">
                                    <tr>
                                        <th>SN</th>
                                        <th>
                                            PROPOSAL
                                        </th>
                                        <th>
                                            DEALS
                                        </th>
                                        <th>
                                            CONTACT NAME
                                        </th>
                                        <th>
                                            TOTAL
                                        </th>
                                        <th>
                                            DATE
                                        </th>
                                        <th>
                                            VALID TILL
                                        </th>
                                        <th>
                                            STATUS
                                        </th>                                      
                                        <th>ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in db.Deals.OrderBy(p => p.insertdate))
                                    {
                                        sn++;

                                        <tr>
                                            <td>@sn</td>
                                            <td>
                                                <a href="@Url.Action("Details", "Proposals", new { id = item.id })">
                                                    @item.name
                                                </a>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Lead_Contact.name)
                                            </td>
                                            <td>
                                                @item.Lead_Contact.email
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.dealvalue)
                                            </td>
                                            <td>
                                                @Convert.ToDateTime(item.closedate).ToShortDateString()
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.dealcategory)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.dealagent)
                                            </td> 
                                            <td>
                                                <div class="dropdown d-inline-block">
                                                    <button type="button" class="btn header-item waves-effect text-dark" id="page-header-user-dropdown"
                                                            data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                        <i class="fa fa-ellipsis-v"></i>
                                                        <i class="mdi mdi-chevron-down d-none d-xl-inline-block"></i>
                                                    </button>
                                                    <div class="dropdown-menu dropdown-menu-end">
                                                        <!-- item-->
                                                        <a class="dropdown-item" href="@Url.Action("Details", "Proposals", new { id = item.id })">
                                                            <i class="bx bxs-detail font-size-16 align-middle me-1"></i>
                                                            View
                                                        </a>
                                                        <a class="dropdown-item" href="@Url.Action("Details", "Deals", new { id = item.id })">
                                                            <i class="bx bxs-download font-size-16 align-middle me-1"></i>
                                                            Download
                                                        </a>
                                                        <a class="dropdown-item" href="#delete_@item.id" data-toggle="modal">
                                                            <i class="bx bx-edit font-size-16 align-middle me-1"></i>
                                                            Edit
                                                        </a>
                                                        <a class="dropdown-item" href="#edit_@item.id" data-toggle="modal">
                                                            <i class="bx bx-send font-size-16 align-middle me-1"></i>
                                                            Send
                                                        </a>
                                                        <a class="dropdown-item" href="@Url.Action("Details", "Deals", new { id = item.id })">
                                                            <i class="bx bxs-message-alt-dots font-size-16 align-middle me-1"></i>
                                                            Mark as Sent
                                                        </a>
                                                        <a class="dropdown-item" href="@Url.Action("Details", "Deals", new { id = item.id })">
                                                            <i class="bx bxs-inbox font-size-16 align-middle me-1"></i>
                                                            Create Invoice
                                                        </a>
                                                        <a class="dropdown-item" href="@Url.Action("Details", "Deals", new { id = item.id })">
                                                            <i class="bx bx-trash font-size-16 align-middle me-1"></i>
                                                            Delete
                                                        </a>
                                                        <a class="dropdown-item" href="#delete_@item.id" data-toggle="modal">
                                                            <i class="bx bx-duplicate font-size-16 align-middle me-1"></i>
                                                            Create Duplicate
                                                        </a>
                                                        <div class="dropdown-divider"></div>
                                                    </div>
                                                </div>


                                                <!---------------------- EDIT DEAL------------------------>
                                                <div id="edit_@item.id" class="modal fade" role="dialog">
                                                    <div class="modal-dialog modal-xl">
                                                        <!-- Modal content-->
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h4 class="modal-title">
                                                                    Edit Deal Info
                                                                </h4>
                                                            </div>
                                                            <div class="modal-body">

                                                                <form class="custom-validation" action="@Url.Action("Edit","Deals")" method="post">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@item.id" />
                                                                    <div class="form-group">
                                                                        <div class="row">
                                                                            <div class="col-md-4">
                                                                                <label class="form-label">Name</label>
                                                                                <input type="text" name="name" class="form-control" value="@item.name" />
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <label class="form-label">Pipeline</label>
                                                                                <input type="text" name="pipeline" class="form-control" value="@item.pipeline" />
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <label class="form-label">Deal Stages</label>
                                                                                <select name="dealcategory" class="form-control">
                                                                                    <option value="@item.dealstages">@item.dealstages</option>
                                                                                    <option>Generated</option>
                                                                                    <option>Qualified</option>
                                                                                    <option>Initial Contact</option>
                                                                                    <option>Schedule Appointment</option>
                                                                                    <option>Proposal Sent</option>
                                                                                    <option>Win</option>
                                                                                    <option>Lost</option>
                                                                                </select>
                                                                            </div>
                                                                        </div>

                                                                        <br />

                                                                        <div class="row">
                                                                            <div class="col-md-4">
                                                                                <label class="form-label">Deal Category</label>
                                                                                <select name="dealcategory" class="form-control" required>
                                                                                    <option value="@item.dealcategory">@item.dealcategory</option>
                                                                                    <option>Best Case</option>
                                                                                    <option>Closed</option>
                                                                                    <option>Commit</option>
                                                                                </select>
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <label>Deal Agent</label>
                                                                                <select class="form-control" name="dealagent" required="">
                                                                                    <option value="@item.dealagent">@item.dealagent</option>
                                                                                    @foreach (var Modal in db.Employees.ToList())
                                                                                    {
                                                                                        <option value="@item.id">@item.name</option>
                                                                                    }
                                                                                </select>
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <label class="form-label">Deal Value</label>
                                                                                <input type="text" name="dealvalue" class="form-control" value="@item.dealvalue" />
                                                                            </div>
                                                                        </div>

                                                                        <br />

                                                                        <div class="row">
                                                                            <div class="col-md-4">
                                                                                <label>Close Date</label>
                                                                                <input type="date" name="closedate" class="form-control" value="@item.closedate" />
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <label class="form-label">Product</label>
                                                                                <input type="text" name="product" class="form-control" value="@item.product" />
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <label>Deal Watcher</label>
                                                                                <select class="form-control" name="dealagent" required="">
                                                                                    <option value="@item.dealwatcher">@item.dealwatcher</option>
                                                                                    @foreach (var Modal in db.Employees.ToList())
                                                                                    {
                                                                                        <option value="@item.id">@item.name</option>
                                                                                    }
                                                                                </select>
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <br />
                                                                    <div class="row">
                                                                        <div class="col-md-12 text-center">
                                                                            <button type="submit" class="btn btn-block btn-success">Submit</button>
                                                                            <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                                                                        </div>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>


                                                <!---------------------- Delete Modal --------------------- -->
                                                <div id="delete_@item.id" class="modal fade" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content shadow-lg border-0 rounded-4">

                                                            <!-- Header -->
                                                            <div class="modal-header bg-danger text-white justify-content-center">
                                                                <h5 class="modal-title fw-bold">
                                                                    <i class="mdi mdi-alert-circle-outline me-2"></i>Are you sure?
                                                                </h5>
                                                            </div>

                                                            <!-- Body -->
                                                            <div class="modal-body text-center p-4">
                                                                <div class="mb-3">
                                                                    <i class="mdi mdi-delete-circle text-danger" style="font-size: 4rem;"></i>
                                                                </div>
                                                                <p class="text-muted mb-0">
                                                                    You will <strong>not</strong> be able to recover the deleted record!
                                                                </p>
                                                                <h6 class="mt-2 text-danger">@item.name</h6>
                                                            </div>

                                                            <!-- Footer -->
                                                            <div class="modal-footer border-0">
                                                                @using (Html.BeginForm("Delete", "Deals", FormMethod.Post, new { @class = "w-100" }))
                                                                {
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@item.id" />
                                                                    <div class="d-flex justify-content-center gap-2">
                                                                        <button type="submit" class="btn btn-danger btn-lg px-4">
                                                                            <i class="mdi mdi-check-circle me-1"></i>Yes, Delete It!
                                                                        </button>
                                                                        <button type="button" class="btn btn-secondary btn-lg px-4" data-bs-dismiss="modal">
                                                                            <i class="mdi mdi-close-circle me-1"></i>Cancel
                                                                        </button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>



                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- CARD VIEW (grouped by stage) -->
                <div id="ifCards" class="row" style="display:none;">
                    @{
                        var stages = new[] { "Generated", "Qualified", "Initial Contact", "Schedule Appointment", "Proposal Sent", "Win", "Lost" };
                        foreach (var stage in stages)
                        {
                            var dealsInStage = db.Deals.Where(d => d.dealstages == stage).OrderBy(d => d.insertdate).ToList();
                            if (!dealsInStage.Any())  // <-- wrapped in block
                            {
                                continue;
                            }

                            <div class="col-lg-4 mb-4">
                                <div class="card stage-card">
                                    <div class="stage-title">@stage <span class="badge badge-primary ml-2">@dealsInStage.Count</span></div>
                                    <div class="card-body p-2">
                                        @foreach (var deal in dealsInStage)
                                        {
                                            <div class="border rounded p-2 mb-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <strong>@deal.name</strong>
                                                    <span class="text-muted">@deal.dealvalue</span>
                                                </div>
                                                <small class="text-muted">@deal.Lead_Contact.name – @deal.Lead_Contact.email</small><br />
                                                <small>Close: @Convert.ToDateTime(deal.closedate).ToShortDateString()</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <script>
                    $('#toggleView').on('click', function () {
                        $('#ifTable').toggle();
                        $('#ifCards').toggle();
                        $(this).find('i').toggleClass('fa-th-large fa-list');
                    });

                    $('.deal-stage').on('change', function () {
                        const $ddl = $(this);
                        const dealId = $ddl.data('deal-id');
                        const newStage = $ddl.val();

                        $.post('@Url.Action("UpdateStage", "Deals")', { id: dealId, stage: newStage })
                         .done(function (res) {
                             if (res.success) toastr.success("Stage saved");
                             else             toastr.error("Save failed");
                         })
                         .fail(function () {
                             toastr.error("Server error");
                             $ddl.val($ddl.data('old')); // rollback
                         });
                    });
                </script>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div id="create" class="modal fade" role="dialog">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header"><h6>Create Lead_Contact</h6></div>
            @using (Html.BeginForm("Create", "Deals", FormMethod.Post, new { @class = "custom-validation" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Lead Contacts</label>
                            <select class="form-control" name="leadcontactid" required="">
                                <option> Select Contacts</option>
                                @foreach (var item in db.Lead_Contact.ToList())
                                {
                                    <option value="@item.id">@item.name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>PipeLine</label>
                            <input type="text" name="pipeline" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label>Deal Name</label>
                            <input type="text" name="name" class="form-control" required />
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-4">
                            <label>
                                Deal Stages
                            </label>
                            <select name="dealstages" class="form-control" required>
                                <option disabled selected>Please Select</option>
                                <option>Generated</option>
                                <option>Qualified</option>
                                <option>Initial Contact</option>
                                <option>Schedule Appointment</option>
                                <option>Proposal Sent</option>
                                <option>Win</option>
                                <option>Lost</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Deal Value</label>
                            <input type="text" name="dealvalue" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label>Close Date</label>
                            <input type="date" name="closedate" class="form-control" required />
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-4">
                            <label>Deal Category</label>
                            <select name="dealcategory" class="form-control" required>
                                <option disabled selected>Please Select</option>
                                <option>Best Case</option>
                                <option>Closed</option>
                                <option>Commit</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Deal Agent</label>
                            <select class="form-control" name="dealagent" required="">
                                <option> Select Contacts</option>
                                @foreach (var item in db.Employees.ToList())
                                {
                                    <option value="@item.id">@item.name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Products</label>
                            <input type="text" name="product" class="form-control" required />
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-12">
                            <label>Deal Watcher</label>
                            <select class="form-control" name="dealwatcher" required="">
                                <option> Select Employee</option>
                                @foreach (var item in db.Employees.ToList())
                                {
                                    <option value="@item.id">@item.name</option>
                                }
                            </select>
                        </div>
                    </div>

                </div>
                <br />
                <div class="row">
                    <div class="col-md-12 text-center">
                        <button type="submit" class="btn btn-success">Create</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    </div>
                </div>
                <br /> <br />
            }
        </div>
    </div>
</div>
